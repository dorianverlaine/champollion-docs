---
import logo from '../assets/logo.png';

/*
 * The mark is the designed icon: a light tile with the Rosetta stone set in
 * it, carved with the first bytes of the repository's `hello` fixture — the
 * exact instruction stream rvrun translates. Champollion deciphered one
 * inscription; this site deciphers this one. The source artwork lived in a
 * screenshot; the PNG beside this component has been masked to the tile's own
 * corner curve (a five-point superellipse) so no white fringes survive on the
 * dark theme.
 */
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<img class="mark" src={logo.src} alt="" width={logo.width} height={logo.height} />
	<span translate="no">{siteTitle}</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		span {
			overflow: hidden;
		}
		.mark {
			block-size: 2.25rem;
			inline-size: 2.25rem;
			flex-shrink: 0;
		}
	}
</style>
