---
const lang = Astro.locals.starlightRoute?.lang ?? 'en';
const locale = Astro.locals.starlightRoute?.locale;
const prefix = locale && locale !== 'root' ? `/${locale}` : '';

const strings: Record<string, { label: string }> = {
	en: { label: 'How rvrun translates: the hello fixture’s first instructions beside their arm64 counterparts' },
	'zh-CN': { label: 'rvrun 如何翻译：hello 程序开头的两条指令与其 arm64 对应指令' },
};
const t = strings[lang] ?? strings.en;

/*
 * The pair on display is the first thing rvrun translates in the hello
 * fixture — the prologue that computes `gp` — beside what the same operation
 * is on arm64. The RISC-V bytes are read straight off the binary that the
 * site's logo is carved with (97 f1 ff ff / 93 81 01 dd); the arm64 bytes are
 * llvm-mc's encodings of `adrp x3, 0xfffff000` / `sub x3, x3, #0x230`.
 */
---

<a class="translation-card" href={`${prefix}/concepts/translation/`} aria-label={t.label}>
	<div class="columns">
		<div class="side">
			<p class="side-label">riscv64</p>
			<div class="pair">
				<p class="bits">10010111 11110001<br />11111111 11111111</p>
				<p class="asm">auipc gp, 0xfffff</p>
			</div>
			<div class="pair">
				<p class="bits">10010011 10000001<br />00000001 11011101</p>
				<p class="asm">addi gp, gp, -0x230</p>
			</div>
		</div>

		<div class="bridge" aria-hidden="true">
			<span class="bridge-arrow">→</span>
			<span class="bridge-chip">rvrun</span>
		</div>

		<div class="side side-end">
			<p class="side-label">arm64</p>
			<div class="pair">
				<p class="bits">11100011 11111111<br />01111111 11110000</p>
				<p class="asm">adrp x3, 0xfffff000</p>
			</div>
			<div class="pair">
				<p class="bits">01100011 11000000<br />00001000 11010001</p>
				<p class="asm">sub x3, x3, #0x230</p>
			</div>
		</div>
	</div>

	<p class="payoff">
		<span class="prompt">$ rvrun tests/fixtures/hello</span>
		<span class="out">hello from riscv64</span>
	</p>
</a>

<style>
	.translation-card {
		--tc-top: #101012;
		--tc-bottom: #18181b;
		display: block;
		margin-block: 2rem;
		padding: 2.25rem 2.5rem 1.25rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1.75rem;
		background: linear-gradient(180deg, var(--tc-top), var(--tc-bottom));
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease;
	}

	:global(:root[data-theme='light']) .translation-card {
		--tc-top: #fbfbfd;
		--tc-bottom: #f4f4f6;
	}

	.translation-card:hover {
		border-color: var(--sl-color-gray-4);
	}

	.columns {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 2rem;
		align-items: center;
	}

	.side-label {
		margin: 0 0 1rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		letter-spacing: 0.06em;
		color: var(--sl-color-gray-3);
	}

	.pair + .pair {
		margin-top: 1.25rem;
	}

	.bits {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		letter-spacing: 0;
		color: var(--sl-color-gray-4);
	}

	.asm {
		margin: 0.25rem 0 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		letter-spacing: 0;
		color: var(--sl-color-white);
	}

	.side-end {
		text-align: end;
	}

	.bridge {
		display: grid;
		justify-items: center;
		gap: 0.5rem;
		color: var(--sl-color-gray-3);
	}

	.bridge-arrow {
		font-size: 1.5rem;
		line-height: 1;
	}

	.bridge-chip {
		padding: 0.25rem 0.625rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.625rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}

	.payoff {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin: 2rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		letter-spacing: 0;
	}

	.prompt {
		color: var(--sl-color-gray-3);
	}

	.out {
		color: var(--sl-color-text-accent);
	}

	@media (max-width: 50rem) {
		.translation-card {
			padding: 1.75rem 1.5rem 1rem;
		}

		.columns {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.side-end {
			text-align: start;
		}

		.bridge {
			grid-auto-flow: column;
			justify-content: start;
			align-items: center;
		}

		.bridge-arrow {
			rotate: 90deg;
		}
	}
</style>
